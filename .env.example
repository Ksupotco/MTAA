# Copy to .env locally. Never commit .env or put keys into browser code.
# 同一组 DeepSeek 配置供三个端点复用：/api/v1/extract、/api/v1/memory-extract、/api/v1/initiative。无需新增密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# A future host endpoint implementing docs/ai-extraction.md; not an existing Whale route.
# WHALE_EXTRACT_URL=http://127.0.0.1:8000/your-extraction-endpoint
# WHALE_API_TOKEN=
# 监听地址：默认仅本机 127.0.0.1；公网部署时由 nginx 反代，仍保持 127.0.0.1（见 deploy/deploy.md）。
# HOST=127.0.0.1
# PORT=18761
# 公网同源放行（部署用）：配置后 POST 端点接受该 Origin（如 https://你的公开域名）。未配置时仅本机同源。
# PUBLIC_ORIGIN=https://demo.example.com
